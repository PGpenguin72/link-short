APP_BASE_URL=http://localhost:8788
PG72_ID_ISSUER=https://sso-preview.pg72.tw
PG72_ID_CLIENT_ID=pg72-link-local
PG72_ID_CLIENT_SECRET=replace-with-a-local-client-secret
